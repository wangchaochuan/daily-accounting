{
	"bsonType": "object",
	"required": [],
	"permission": {
		"read": true,
		"create": true,
		"update": true,
		"delete": false
	},
	"properties": {
		"_id": {
			"description": "ID，系统自动生成"
		},
		"mp_wx_openid": {
			"bsonType": "string",
			"description": "微信小程序平台openid"
		},
		"register_date": {
			"bsonType": "timestamp",
			"description": "注册时间",
			"forceDefaultValue": {
				"$env": "now"
			}
		},
		"nick_name": {
			"bsonType": "string",
			"description": "昵称",
			"title": "昵称",
			"defaultValue": "微信用户"
		},
		"avatar": {
			"bsonType": "file",
			"description": "用file类型方便使用uni-file-picker组件",
			"title": "头像文件"
		},
		"gender": {
			"bsonType": "int",
			"defaultValue": 0,
			"description": "用户性别：0 保密 1 男性 2 女性",
			"enum": [{
				"text": "保密",
				"value": 0
			}, {
				"text": "男",
				"value": 1
			}, {
				"text": "女",
				"value": 2
			}],
			"title": "性别"
		},
		"age": {
			"bsonType": "int",
			"description": "年龄",
			"title": "年龄"
		},
		"height": {
			"bsonType": "double",
			"description": "身高",
			"title": "身高"
		},
		"weight": {
			"bsonType": "double",
			"description": "体重",
			"title": "体重"
		}
	}
}